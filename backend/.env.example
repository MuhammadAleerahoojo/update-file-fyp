# Optional. CT analysis uses a vision-language model and is disabled without this key.
ANTHROPIC_API_KEY=
# Supabase JWT secret. When set, /caption requires a signed-in user's token (recommended in production).
SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed to call the API (your deployed frontend URL).
CORS_ORIGINS=http://localhost:5173
# Validation tuning (defaults shown)
# VALIDATION_MIN_CONFIDENCE=0.50
# VALIDATION_MIN_MARGIN=0.10
# VALIDATION_MAX_SATURATION=0.25
