# Local development — copy this file to .env and fill in your values.
# Restart `npm run dev` after any change; Vite only reads .env at startup.

# Supabase — Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# FastAPI analysis backend (see backend/README.md) that serves POST /caption.
# Optional: defaults to http://127.0.0.1:8000 when unset.
# This MUST be set for any deployed build — otherwise the browser tries to
# reach the analysis service on the visitor's own machine.
VITE_AI_API_URL=http://127.0.0.1:8000
